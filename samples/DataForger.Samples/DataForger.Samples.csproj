<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <SignAssembly>false</SignAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ponytail: sample app skips StyleCop to keep it minimal. -->
  <ItemGroup>
    <PackageReference Remove="StyleCop.Analyzers" />
    <AdditionalFiles Remove="$(MSBuildThisFileDirectory)../../build/stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataForger\DataForger.csproj" />
    <ProjectReference Include="..\..\src\DataForger.Abstractions\DataForger.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\DataForger.CountryProviders\DataForger.CountryProviders.csproj" />
    <ProjectReference Include="..\..\src\DataForger.Generators\DataForger.Generators.csproj" />
    <ProjectReference Include="..\..\src\DataForger.Extensions\DataForger.Extensions.csproj" />
  </ItemGroup>

</Project>
