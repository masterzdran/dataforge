<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ponytail: demo app skips StyleCop to keep it minimal, like DataForger.Samples. -->
  <ItemGroup>
    <PackageReference Remove="StyleCop.Analyzers" />
    <AdditionalFiles Remove="$(MSBuildThisFileDirectory)../../build/stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Points at the source so the demo works before DataForger.* hits nuget.org -->
    <ProjectReference Include="..\..\src\DataForger\DataForger.csproj" />
  </ItemGroup>

</Project>