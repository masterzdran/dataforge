<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DataForge.UnitTests</RootNamespace>
    <AssemblyName>DataForge.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)../../artifacts/coverage/</CoverletOutput>
    <Threshold>90</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Exclude>[xunit.*]*,[DataForge.UnitTests]*</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataForge.Abstractions\DataForge.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\DataForge.CountryProviders\DataForge.CountryProviders.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Generators\DataForge.Generators.csproj" />
    <ProjectReference Include="..\..\src\DataForge\DataForge.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Extensions\DataForge.Extensions.csproj" />
  </ItemGroup>

</Project>
